# Vercel KV Configuration
# Copy this file to .env.local and add your actual Vercel KV credentials

# Vercel KV Redis URL (get from Vercel dashboard)
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# Optional: KV URL for direct Redis connection
KV_URL=your_kv_url_here

# Admin token — required for delete/reset/migrate-modes endpoints AND for PROFILE_UPDATE.
# If unset, all admin endpoints reject (fail-closed). Use a long random string.
ADMIN_TOKEN=replace_with_long_random_string